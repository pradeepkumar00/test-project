# Production / CI environment variables
# See DEPLOYMENT.md for the first-time deploy checklist.
# Full mapping: Backend/config/custom-environment-variables.json
#
# For local development prefer:
#   cp Backend/config/local.example.json Backend/config/local.json

NODE_ENV=production
PORT=5000
APP_NAME=Masti Ludo
APP_URL=https://play.yourdomain.com

MONGODB_URI=mongodb+srv://USER:PASS@cluster/bigfun?retryWrites=true&w=majority
REDIS_URL=redis://:PASSWORD@redis-host:6379
REDIS_KEY_PREFIX=mastiludo:

JWT_SECRET=change-me-user-jwt
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change-me-admin-jwt
ADMIN_JWT_EXPIRES_IN=1d

OTP_CHANNEL=whatsapp
OTP_BYPASS_ENABLED=false
# OTP_BYPASS_CODE=000000

WHATSAPP_PROVIDER=twilio
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=whatsapp:+1XXXXXXXXXX
WHATSAPP_TWILIO_COUNTRY_CODE=+91
WHATSAPP_TWILIO_CONTENT_SID=

S3_ENABLED=true
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=battles/

UPI_ID=
MIN_DEPOSIT=100
MIN_WITHDRAW=110
REFERRAL_BONUS=50
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUEST_BODY=false
